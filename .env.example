# Postgres connection string (pooled). Required: every visitor gets a guest
# session backed by this database, so the app does not start without it.
DATABASE_URL="postgres://user:password@host:5432/nationaldex"

# better-auth
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
# The app's own URL. In development any origin is trusted, so the dev server
# can run on whichever port is free (3001 when 3000 is taken) and the PWA can
# be opened from a phone on the LAN.
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth (optional — email/password and guest mode work without it)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
